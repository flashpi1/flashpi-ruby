# The resources of the client: `client.invoices`, `client.documents`, `client.issuers`...
#
# Every method takes the per-call options as keywords: `idempotency_key` (POSTs), `timeout`,
# `max_retries`, `language`, `correlation_id` and `extra_headers`.
module Flashpi
  module Resources
    # Issues one document type.
    class DocumentIssuer[B] < Internal::Resource
      # The path of the document type, set by each subclass.
      PATH: String
      DEFAULT_WAIT_SECONDS: Integer
      SYNC_MARGIN_SECONDS: Integer
      def self.sync_timeout_floor: (untyped body) -> Float
      def self.member: (untyped value, Symbol name) -> untyped

      def with_response: () -> DocumentIssuer::WithResponse[B]

      def create: (
        B body,
        ?idempotency_key: String?, ?timeout: Types::seconds?, ?max_retries: Integer?,
        ?language: Types::request_language?, ?correlation_id: String?, ?extra_headers: Types::headers?
      ) -> Types::document
    end

    # `DocumentIssuer`'s methods, returning an APIResponse with the HTTP status, headers and request id.
    class DocumentIssuer::WithResponse[B] < Internal::ResponseView
      def initialize: (DocumentIssuer[B] resource) -> void

      def create: (
        B body,
        ?idempotency_key: String?, ?timeout: Types::seconds?, ?max_retries: Integer?,
        ?language: Types::request_language?, ?correlation_id: String?, ?extra_headers: Types::headers?
      ) -> APIResponse[Types::document]
    end

    # Every issued document, of any type: search, XML, RIDE (PDF) and email.
    class Documents < Internal::Resource
      XML_ACCEPT: String
      PDF_ACCEPT: String
      XML_KINDS: Array[String]

      def with_response: () -> Documents::WithResponse

      def list: (
        ?Types::document_list_params? params,
        ?idempotency_key: String?, ?timeout: Types::seconds?, ?max_retries: Integer?,
        ?language: Types::request_language?, ?correlation_id: String?, ?extra_headers: Types::headers?
      ) -> Page[Types::document]

      def get: (
        String document_id,
        ?idempotency_key: String?, ?timeout: Types::seconds?, ?max_retries: Integer?,
        ?language: Types::request_language?, ?correlation_id: String?, ?extra_headers: Types::headers?
      ) -> Types::document

      def xml: (
        String document_id,
        ?idempotency_key: String?, ?timeout: Types::seconds?, ?max_retries: Integer?,
        ?language: Types::request_language?, ?correlation_id: String?, ?extra_headers: Types::headers?
      ) -> Types::document_xml

      def pdf: (
        String document_id,
        ?idempotency_key: String?, ?timeout: Types::seconds?, ?max_retries: Integer?,
        ?language: Types::request_language?, ?correlation_id: String?, ?extra_headers: Types::headers?
      ) -> String

      def send_email: (
        String document_id,
        ?idempotency_key: String?, ?timeout: Types::seconds?, ?max_retries: Integer?,
        ?language: Types::request_language?, ?correlation_id: String?, ?extra_headers: Types::headers?
      ) -> Types::document
    end

